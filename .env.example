# Database credentials used by the API. ESPN credentials are supplied only in login requests.
DB_USER=
DB_PASS=
PORT=3001

# Optional: use an installed Chrome/Chromium executable instead of Puppeteer's downloaded browser.
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Dedicated private folder for reusable ESPN browser sessions; keep this on persistent storage.
# Without persistent storage, server rebuilds/redeployments can require a fresh login.
# ESPN_SESSION_DIR=/var/data/espn-sessions
